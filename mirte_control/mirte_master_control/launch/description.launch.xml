<launch>
  <!-- description.launch.xml: Generate the 'robot_description' launch configuration -->

  <!-- Control Options -->
  <arg name="config_file"
    description="The MIRTE control configuration file, if not specified the ENV override or the default config will be used."
    default="$(env MIRTE_CONTROL_CONFIG '$(find-pkg-share mirte_master_control)/config/default_hardware.yaml')" />

  <arg name="hardware_namespace" default=""
    description="The namespace containing the Telemetrix Node and the hardware peripherals. (Overrides the config specified value)" />

  <arg name="base_motors" default="multi_motor"
    description="Hardware interface type(s) for the base motors (Used by the Mecanum Drive)">
    <choice value="multi_motor" />
    <choice value="single_motors" />
  </arg>

  <arg name="base_encoders" default="single_encoders"
    description="Hardware interface type(s) for the base encoders (Used by the Mecanum Drive)">
    <choice value="single_encoders" />
  </arg>

  <!-- TODO: Maybe split into arm and gripper/end-effector -->
  <arg name="hardware_interface_arm" default="old"
    description="Hardware interface type(s) for the arm">
    <choice value="old" />
  </arg>

  <!-- Global Xacro Options -->
  <let name="xacro_options" value="include_old_sim_control:=False" />
  <let name="xacro_options" value="$(var xacro_options) hardware_namespace:='$(var hardware_namespace)'" />

  <!-- Control Options -->
  <let name="xacro_options" value="$(var xacro_options) control_config_file:=$(var config_file)" />
  <let name="xacro_options" value="$(var xacro_options) base_motors:=$(var base_motors)" />
  <let name="xacro_options" value="$(var xacro_options) base_encoders:=$(var base_encoders)" />
  <let name="xacro_options" value="$(var xacro_options) hardware_interface_arm:=$(var hardware_interface_arm)" />

  <!-- XACRO Description Options -->
  <include file="$(find-pkg-share mirte_master_description)/launch/xacro_options.launch.xml" />

  <!-- NOTE(SuperJappie08): The next argument allows for shell escaping, which could be a security
        risk. However it provides unrestricted functionality in the most flexible way -->
  <arg name="extra_xacro_args" default="" description="Additional xacro configuration commands" />
  <let name="xacro_options" value="$(var xacro_options) $(var extra_xacro_args)" />

  <let name="robot_description"
    value="$(command 'xacro $(find-pkg-share mirte_master_control)/urdf/mirte_master_combined.urdf.xacro $(var xacro_options)')" />
</launch>
