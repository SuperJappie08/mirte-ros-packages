<launch>
  <let name="ansi-escape" value="$(eval 'chr(0o33)')" />
  <let name="warning-block" value="$(var ansi-escape)[1;33m[WARNING]$(var ansi-escape)[0m"/>
  <log message="$(var warning-block) The arm controller/hardware interface has not been revised." />

  <!-- Exposed for THESIS research -->
  <arg name="arm_controller_rate"
    default="$(env MIRTE_CONTROL_THESIS_ARM_CONTROLLER_RATE $(var controller_manager_rate))"/>

  <spawn_controller>
    <controller name="mirte_master_arm_controller">
      <param from="$(find-pkg-share mirte_master_control)/config/controllers/arm/arm_controllers.yaml"/>

      <!-- Exposed for THESIS research -->
      <param name="update_rate" value="$(var arm_controller_rate)" />
    </controller>
    <controller name="mirte_master_gripper_controller">
      <!-- This file can technically be omitted, since it is loaded
        by the previous controller and by the controller manager at startup -->
      <param from="$(find-pkg-share mirte_master_control)/config/controllers/arm/arm_controllers.yaml"/>

      <!-- Exposed for THESIS research -->
      <param name="update_rate" value="$(var arm_controller_rate)" />
    </controller>
  </spawn_controller>
</launch>
